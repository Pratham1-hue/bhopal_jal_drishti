# Copy this file to backend/.env (or the repo root .env). Never commit the real .env.

# Optional. Without it, briefs come from the verified template (still Hindi + English).
ANTHROPIC_API_KEY=
# Any current Claude model id your key can use.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: "sample" uses data/sample_bhopal_2025.csv (2025 only) for quick testing.
DATASET=full
